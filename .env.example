# Supabase Environment Variables Configuration
# Replace with your project details from Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-browser-anon-key

# WARNING: NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend code or repository!
